	Enabled = false,
	Shape = "Cone", -- "Corda", "Cone", "Wedge", "Cano de fogao"
	MPH = 120, -- 0 a 300
	Subvortices = false,
	SubMPH = 180, -- 0 a 400
	Origin = Vector3.new(0, 0, 0),
	HasOrigin = false,
}

-- ==========================================
-- PASTA DO TORNADO & WINDFIELD
-- ==========================================
local tornadoFolder = Instance.new("Folder")
tornadoFolder.Name = "TornadoSystemFolder"
tornadoFolder.Parent = workspace

local mainTornadoModel = Instance.new("Model")
mainTornadoModel.Name = "MainTornado"
mainTornadoModel.Parent = tornadoFolder

local subVorticesFolder = Instance.new("Folder")
subVorticesFolder.Name = "SubVorticesFolder"
subVorticesFolder.Parent = tornadoFolder

local function getCurrentOrigin()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not state.HasOrigin and root then
		state.Origin = root.Position - Vector3.new(0, 3, 0) + (root.CFrame.LookVector * 35)
		state.HasOrigin = true
	end
	return state.Origin
end

local function clearVisuals()
	mainTornadoModel:ClearAllChildren()
	subVorticesFolder:ClearAllChildren()
end

local function createVortexPart(parent, name, size, cframe, transparency, color)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = transparency
	p.Color = color
	p.Parent = parent
	return p
end

-- Gera camadas visuais conforme o formato escolhido
local function rebuildTornadoVisuals()
	clearVisuals()
	if not state.Enabled then return end

	local basePos = getCurrentOrigin()
	local powerRatio = math.clamp(state.MPH / 300, 0, 1)
	local height = 55 + (powerRatio * 95)
	local layers = 18
	local spinAngle = tick() * (4 + powerRatio * 18)

	for i = 1, layers do
		local t = (i - 1) / (layers - 1) -- 0 (base) até 1 (topo)
		local yPos = basePos.Y + (t * height)
		local radius = 6

		if state.Shape == "Corda" then
			-- Fina e quase constante do chão ao topo
			radius = 4.5 + (t * 2.5) + (powerRatio * 2)
		elseif state.Shape == "Cone" then
			-- Estreita embaixo e larga no topo
			radius = 5 + (t ^ 1.35) * (28 + powerRatio * 14)
		elseif state.Shape == "Wedge" then
			-- Em cunha / mais aberta e inclinada
			radius = 6 + (t * (24 + powerRatio * 12))
		elseif state.Shape == "Cano de fogao" then
			-- Cilíndrica / stovepipe bem definida
			radius = 12 + (powerRatio * 7) + math.sin(t * math.pi * 4) * 1.2
		end

		local offsetX = 0
		local offsetZ = 0
		if state.Shape == "Wedge" then
			offsetX = t * (10 + powerRatio * 10)
		elseif state.Shape == "Corda" then
			offsetX = math.sin(t * 7 + spinAngle * 0.4) * 3.5
			offsetZ = math.cos(t * 7 + spinAngle * 0.4) * 3.5
		end

		local layerCenter = Vector3.new(basePos.X + offsetX, yPos, basePos.Z + offsetZ)
		local segCount = (state.Shape == "Corda") and 6 or 10
		local segHeight = (height / layers) * 1.15
		local segWidth = math.max(2.2, (2 * math.pi * radius) / segCount * 0.92)
		local segThickness = math.max(1.2, radius * 0.14)

		for s = 1, segCount do
			local angle = spinAngle + ((s / segCount) * math.pi * 2) + (t * 2.2)
			local px = layerCenter.X + math.cos(angle) * radius
			local pz = layerCenter.Z + math.sin(angle) * radius
			local cf = CFrame.lookAt(Vector3.new(px, yPos, pz), Vector3.new(layerCenter.X, yPos, layerCenter.Z))

			local transp = math.clamp(0.42 + (t * 0.42) - (powerRatio * 0.12), 0.25, 0.9)
			local col = Color3.fromRGB(165, 172, 182):Lerp(Color3.fromRGB(95, 102, 115), t)

			createVortexPart(
				mainTornadoModel,
				"Layer_" .. i .. "_Seg_" .. s,
				Vector3.new(segWidth, segHeight, segThickness),
				cf,
				transp,
				col
			)
		end
	end

	-- Subvórtices (se ativado)
	if state.Subvortices then
		local subCount = 5
		local subPower = math.clamp(state.SubMPH / 400, 0, 1)
		local orbitRadius = 18 + (powerRatio * 20)
		local subHeight = 22 + (subPower * 35)

		for v = 1, subCount do
			local vAngle = (spinAngle * 0.65) + ((v / subCount) * math.pi * 2)
			local vx = basePos.X + math.cos(vAngle) * orbitRadius
			local vz = basePos.Z + math.sin(vAngle) * orbitRadius

			for k = 1, 8 do
				local kt = (k - 1) / 7
				local ky = basePos.Y + (kt * subHeight)
				local rSub = 2.2 + (kt * (5 + subPower * 5))
				local subSpin = spinAngle * 1.8 + (kt * 2)

				for m = 1, 5 do
					local mAng = subSpin + ((m / 5) * math.pi * 2)
					local mx = vx + math.cos(mAng) * rSub
					local mz = vz + math.sin(mAng) * rSub
					local cf = CFrame.lookAt(Vector3.new(mx, ky, mz), Vector3.new(vx, ky, vz))
					createVortexPart(
						subVorticesFolder,
						"Sub_" .. v .. "_" .. k .. "_" .. m,
						Vector3.new(1.8, (subHeight / 8) * 1.1, 1.0),
						cf,
						0.45 + (kt * 0.35),
						Color3.fromRGB(130, 138, 150)
					)
				end
			end
		end
	end
end

-- ==========================================
-- FÍSICA & WINDFIELD
-- ==========================================
local function applyWindAndPull(dt)
	if not state.Enabled then
		workspace.GlobalWind = Vector3.zero
		return
	end

	local origin = getCurrentOrigin()
	local mph = state.MPH
	local maxRadius = 45 + (mph / 300) * 115
	local pullStrength = (mph / 300) * 140
	local swirlStrength = (mph / 300) * 165
	local liftStrength = (mph / 300) * 65

	-- Atualiza GlobalWind (WindField nativo do Roblox para folhagens, nuvens, partículas, etc.)
	local windAngle = tick() * (1.5 + (mph / 300) * 5)
	local windMag = (mph / 300) * 120
	workspace.GlobalWind = Vector3.new(
		math.cos(windAngle) * windMag,
		(mph / 300) * 25,
		math.sin(windAngle) * windMag
	)

	-- Coleta centros de influência (tornado principal + subvórtices)
	local vortexCenters = {
		{ pos = origin, radius = maxRadius, pull = pullStrength, swirl = swirlStrength, lift = liftStrength }
	}

	if state.Subvortices then
		local subMph = state.SubMPH
		local subCount = 5
		local orbitRadius = 18 + ((mph / 300) * 20)
		local baseAngle = (tick() * (4 + (mph / 300) * 18)) * 0.65
		local subRadius = 22 + (subMph / 400) * 45
		local subPull = (subMph / 400) * 190
		local subSwirl = (subMph / 400) * 220
		local subLift = (subMph / 400) * 95

		for v = 1, subCount do
			local vAng = baseAngle + ((v / subCount) * math.pi * 2)
			local vPos = Vector3.new(
				origin.X + math.cos(vAng) * orbitRadius,
				origin.Y,
				origin.Z + math.sin(vAng) * orbitRadius
			)
			table.insert(vortexCenters, {
				pos = vPos,
				radius = subRadius,
				pull = subPull,
				swirl = subSwirl,
				lift = subLift,
			})
		end
	end

	-- Aplica puxada e rotação em partes não ancoradas e personagens próximos
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and not obj.Anchored and not obj:IsDescendantOf(tornadoFolder) then
			local totalForce = Vector3.zero
			for _, vc in ipairs(vortexCenters) do
				local flatDelta = Vector3.new(vc.pos.X - obj.Position.X, 0, vc.pos.Z - obj.Position.Z)
				local dist = flatDelta.Magnitude
				local heightDiff = math.abs(obj.Position.Y - vc.pos.Y)

				if dist < vc.radius and heightDiff < 120 then
					local falloff = 1 - (dist / vc.radius)
					local radialDir = dist > 0.01 and flatDelta.Unit or Vector3.zero
					local tangentDir = Vector3.new(-radialDir.Z, 0, radialDir.X)

					local pullVec = radialDir * (vc.pull * falloff)
					local swirlVec = tangentDir * (vc.swirl * falloff)
					local liftVec = Vector3.new(0, vc.lift * falloff * (dist < vc.radius * 0.5 and 1 or 0.35), 0)

					totalForce += (pullVec + swirlVec + liftVec) * obj.Mass
				end
			end

			if totalForce.Magnitude > 0.1 then
				obj:ApplyImpulse(totalForce * dt * 8)
			end
		end
	end
end

